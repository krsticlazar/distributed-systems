<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.serviceModel>
    <bindings>
        <wsDualHttpBinding>
            <binding name="WSDualHttpBinding_IProizvodnjaService">
                <security mode="None" />
            </binding>
            <binding name="WSDualHttpBinding_IProizvodnjaService1">
                <security mode="None" />
            </binding>
            <binding name="WSDualHttpBinding_IProizvodnjaService2">
                <security mode="None" />
            </binding>
        </wsDualHttpBinding>
    </bindings>
    <client>
        <endpoint address="http://localhost:55103/ProizvodnjaService.svc"
            binding="wsDualHttpBinding" bindingConfiguration="WSDualHttpBinding_IProizvodnjaService"
            contract="WCFProizvodnjaServer.IProizvodnjaService" name="WSDualHttpBinding_IProizvodnjaService" />
        <endpoint address="http://localhost:55103/ProizvodnjaService.svc"
            binding="wsDualHttpBinding" bindingConfiguration="WSDualHttpBinding_IProizvodnjaService1"
            contract="ServiceProizvodnja.IProizvodnjaService" name="WSDualHttpBinding_IProizvodnjaService1" />
        <endpoint address="http://localhost:55103/ProizvodnjaService.svc"
            binding="wsDualHttpBinding" bindingConfiguration="WSDualHttpBinding_IProizvodnjaService2"
            contract="ServiceReferenceProizvodnja.IProizvodnjaService"
            name="WSDualHttpBinding_IProizvodnjaService2" />
    </client>
  </system.serviceModel>
</configuration>
