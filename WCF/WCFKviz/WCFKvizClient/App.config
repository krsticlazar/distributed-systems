<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IKvizService" />
      </basicHttpBinding>
    </bindings>
    <client>
      <endpoint address="http://localhost:55101/KvizService.svc"
                binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_IKvizService"
                contract="WCFKvizServer.IKvizService"
                name="BasicHttpBinding_IKvizService" />
    </client>
  </system.serviceModel>
</configuration>
