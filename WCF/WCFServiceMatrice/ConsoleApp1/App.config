<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <system.serviceModel>
    <bindings>
      <basicHttpBinding>
        <binding name="BasicHttpBinding_IServiceMatrice" />
      </basicHttpBinding>
    </bindings>

    <client>
      <endpoint address="http://localhost:54991/ServiceMatrice.svc"
                binding="basicHttpBinding"
                bindingConfiguration="BasicHttpBinding_IServiceMatrice"
                contract="WcfService1.IServiceMatrice"
                name="BasicHttpBinding_IServiceMatrice" />
    </client>
  </system.serviceModel>
</configuration>
